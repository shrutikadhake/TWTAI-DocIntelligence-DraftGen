        "content": [
          {
            "component": "cards",
            "items": [
              {
                "title": "Model Registry",
                "text": "Stores versioned models."
              },
              {
                "title": "Deployment Engine",
                "text": "Deploys containers."
              },
              {
                "title": "Inference Gateway",
                "text": "Routes prediction requests."
              },
              {
                "title": "Monitoring",
                "text": "Collects metrics and alerts."
