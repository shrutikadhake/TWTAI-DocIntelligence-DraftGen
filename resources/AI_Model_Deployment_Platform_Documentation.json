        "title": "Executive Summary",
        "content": [
          {
            "component": "paragraph",
            "text": "The AI Model Deployment Platform enables ML teams to package, validate, deploy, monitor and roll back machine learning models across environments."
          },
          {
            "component": "callout",
            "variant": "info",
            "title": "Purpose",
            "text": "Standardize model deployment with governance and observability."
          },
          {
            "component": "list",
            "style": "bullet",
            "items": [
              "Model Registry",
              "CI/CD Integration",
              "Blue-Green Deployment",
              "Canary Releases",
              "Monitoring",
              "Audit Logs"
            ]
          }
        ]
      },
      {
